{
  "name": "@compuzz-eventus/backbone",
  "description": "Give your JS App some Backbone with Models, Views, Collections, and Events.",
  "url": "http://backbonejs.org",
  "keywords": [
    "model",
    "view",
    "controller",
    "router",
    "server",
    "client",
    "browser"
  ],
  "author": "Jeremy Ashkenas",
  "dependencies": {
    "underscore": "^1.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/coverage-v8": "^4.1.6",
    "cpy-cli": "^7.0.0",
    "docco": "^0.9.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jquery": "^4.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "qunit": "^2.17.2",
    "replace-in-file": "^8.4.0",
    "rollup": "^4.60.3",
    "simple-git-hooks": "^2.13.1",
    "terser": "^5.47.1",
    "vitest": "^4.1.6"
  },
  "scripts": {
    "test": "vitest run && node test/model-inheritance.js && yarn lint",
    "test:coverage": "vitest run --coverage",
    "build": "terser backbone.js --compress --mangle --source-map \"url='backbone-min.js.map'\" --comments \"/^!|@preserve|@license|@cc_on/i\" -o backbone-min.js",
    "build-debug": "rollup -e @compuzz-eventus/backbone -f umd -g @compuzz-eventus/backbone:Backbone -n Backbone.debugInfo -o debug-info.js --no-strict modules/debug-info.js",
    "alias-sourcemap": "cpy --rename=backbone-min.map backbone-min.js.map .",
    "doc": "docco backbone.js && docco examples/todos/todos.js examples/backbone.localStorage.js",
    "lint": "eslint backbone.js test/*.js modules/*.js",
    "mark-release": "replace-in-file MARK_DEVELOPMENT MARK_RELEASE modules/debug-info.js && yarn build-debug",
    "mark-develop": "replace-in-file MARK_RELEASE MARK_DEVELOPMENT modules/debug-info.js && yarn build-debug",
    "prepublishOnly": "yarn test && yarn mark-release && yarn build && yarn alias-sourcemap && yarn doc",
    "postpublish": "yarn mark-develop",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "yarn lint-staged"
  },
  "lint-staged": {
    "{backbone.js,modules/**/*.js,test/**/*.js}": "eslint --fix"
  },
  "main": "backbone.js",
  "exports": {
    ".": {
      "import": "./backbone.mjs",
      "require": "./backbone.js",
      "default": "./backbone.js"
    },
    "./debug-info": "./debug-info.js",
    "./modules/debug-info": "./modules/debug-info.js",
    "./package.json": "./package.json"
  },
  "version": "1.7.0",
  "license": "MIT",
  "packageManager": "yarn@4.14.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/compuzz-eventus/backbone.git"
  },
  "files": [
    "backbone.js",
    "backbone.mjs",
    "backbone-min.js",
    "backbone-min.js.map",
    "backbone-min.map",
    "debug-info.js",
    "LICENSE",
    "modules/debug-info.js",
    "modules/package.json"
  ]
}
